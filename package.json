{
  "name": "agentos-eth-shenzhen",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test": "node --test --test-concurrency=2 tests/*.test.ts tests/*.test.mjs",
    "typecheck": "tsc --noEmit && tsc -p cre/tsconfig.json",
    "contracts:compile": "node scripts/compile-contracts.mjs",
    "cre:build": "node scripts/cre-build.mjs",
    "db:local": "node scripts/db-local.mjs",
    "test:api": "node scripts/test-api.mjs",
    "worker": "node scripts/worker.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:chain": "node scripts/demo-chain.mjs",
    "demo:deadline": "node scripts/demo-deadline.mjs",
    "cre:prepare": "node scripts/cre-prepare.mjs",
    "cre:cli-build": "node scripts/cre-cli.mjs build",
    "cre:simulate": "node scripts/cre-cli.mjs simulate",
    "chain:local": "node scripts/local-chain.mjs",
    "demo:wallet": "node scripts/demo-wallet.mjs",
    "demo:cre": "node scripts/cre-cli.mjs build && node scripts/demo-cre.mjs",
    "demo:reconcile": "node scripts/demo-reconciliation.mjs",
    "demo:prefund": "node scripts/demo-prefund.mjs",
    "model:setup": "node scripts/model-setup.mjs",
    "model:local": "node scripts/model-local.mjs",
    "demo:model": "node scripts/demo-model.mjs",
    "demo:identity": "node scripts/demo-identity.mjs",
    "supplier:local": "node scripts/supplier-local.mjs",
    "demo:supplier": "node scripts/demo-supplier.mjs",
    "demo:queue": "node scripts/demo-queue.mjs",
    "demo:start": "node scripts/demo-start.mjs",
    "demo:doctor": "node scripts/demo-doctor.mjs",
    "demo:prepare": "node scripts/demo-prepare.mjs",
    "demo:planning": "node scripts/demo-planning.mjs",
    "demo:showcase": "node scripts/demo-showcase.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "demo:evidence": "node scripts/demo-evidence.mjs",
    "demo:full": "node scripts/demo-full.mjs",
    "demo:data": "node scripts/demo-data.mjs",
    "demo:isolated": "node scripts/demo-isolated.mjs",
    "demo:vault": "node scripts/demo-vault.mjs",
    "demo:workflow": "node scripts/demo-workflow.mjs",
    "test:cre": "node scripts/test-cre.mjs",
    "demo:cre-dispatcher": "node scripts/cre-cli.mjs build && node scripts/test-cre.mjs && node scripts/demo-cre-dispatcher.mjs",
    "skill:conformance": "node scripts/skill-conformance.mjs",
    "demo:skill": "node scripts/demo-skill.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@chainlink/cre-sdk": "^1.23.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "viem": "^2.57.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openzeppelin/contracts": "5.4.0",
    "@openzeppelin/contracts-upgradeable": "5.4.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
