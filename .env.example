
# Optional server-only Ethereum mainnet RPC for read-only USDC provenance.
# Production has no default; loopback development uses PublicNode.
# AGENTOS_DATA_RPC_URL=https://your-mainnet-rpc.example/

# Optional server-only public evidence writer. Dataset and artifacts become public.
# AGENTOS_EVIDENCE_CONFIGURATION={"origin":"https://your-evidence-service.example"}
# AGENTOS_EVIDENCE_WRITE_TOKEN=configure-a-random-secret-outside-source-control

# Optional dedicated server-only model for multi-step planning. Local development
# defaults to the pinned Qwen 3B service on 127.0.0.1:11436. A hosted model uses HTTPS.
# AGENTOS_WORKFLOW_MODEL_CONFIGURATION={"url":"https://your-model.example/v1/chat/completions","model":"your-planning-model","revision":"pinned-version","timeoutMs":60000,"maxTokens":512}
# AGENTOS_WORKFLOW_MODEL_API_KEY=configure-outside-source-control

# Optional independent server-only embedding provider. Loopback defaults to the
# pinned Qwen3 embedding model on 11437; hosted use requires explicit HTTPS.
# AGENTOS_MEMORY_MODEL_CONFIGURATION={"url":"https://your-embedding.example/v1/embeddings","model":"your-model","revision":"pinned-version","timeoutMs":60000,"inputDimensions":1024,"dimensions":256}
# AGENTOS_MEMORY_MODEL_API_KEY=configure-outside-source-control
